# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Raw snapshots not wired into docs.json (markdown-only or diagrams)
.raw-openapi/

# Internal authoring instructions — not a customer page
AGENTS.md

# Local Mintlify preview cache
.mintlify-home/
