{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Bit2Me API",
  "description": "Official Bit2Me developer portal for Wallet, Pro trading, partner integrations, and MCP.",
  "colors": {
    "primary": "#0046E1",
    "light": "#99AFFF",
    "dark": "#001A33"
  },
  "fonts": {
    "family": "Manrope",
    "heading": {
      "family": "Rubik",
      "weight": 700
    },
    "body": {
      "family": "Manrope",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FFFFFF",
      "dark": "#001A33"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://support.bit2me.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API keys",
      "href": "https://account.bit2me.com/api-keys"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/bit2me",
      "linkedin": "https://linkedin.com/company/bit2me",
      "youtube": "https://www.youtube.com/@Bit2MeOfficial"
    },
    "links": [
      {
        "header": "Operations",
        "items": [
          {
            "label": "API status",
            "href": "https://status.bit2me.com"
          },
          {
            "label": "Current API reference (Scalar)",
            "href": "https://api.bit2me.com/doc"
          },
          {
            "label": "Changelog",
            "href": "/changelog"
          }
        ]
      },
      {
        "header": "Help",
        "items": [
          {
            "label": "Help center",
            "href": "https://support.bit2me.com"
          },
          {
            "label": "Submit a ticket",
            "href": "https://support.bit2me.com/en/support/tickets/new"
          }
        ]
      },
      {
        "header": "Company",
        "items": [
          {
            "label": "Bit2Me",
            "href": "https://bit2me.com"
          },
          {
            "label": "Brand resources",
            "href": "https://bit2me.com/press"
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": [
      "openapi/crypto.json",
      "openapi/trading-spot-rest.json",
      "openapi/embed.json"
    ],
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "bash",
        "node",
        "python"
      ],
      "defaults": "required"
    },
    "mdx": {
      "server": "https://gateway.bit2me.com"
    },
    "asyncapi": "asyncapi/trading.yaml"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "href": "https://status.bit2me.com",
          "icon": "activity"
        },
        {
          "anchor": "Support",
          "href": "https://support.bit2me.com",
          "icon": "life-ring"
        }
      ]
    },
    "dropdowns": [
      {
        "dropdown": "Wallet API",
        "description": "Custody, buy, sell, earn, and loans",
        "icon": "wallet",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "index",
                  "quickstart",
                  "guides/account-model",
                  "guides/authentication",
                  "guides/rate-limits",
                  "guides/errors",
                  "changelog"
                ]
              },
              {
                "group": "Wallet",
                "pages": [
                  "wallet/pockets",
                  "wallet/buy-sell",
                  "wallet/earn",
                  "wallet/loans",
                  "wallet/money-flow"
                ]
              },
              {
                "group": "Pro",
                "pages": [
                  "pro/overview",
                  "pro/first-order",
                  "pro/market-data",
                  "pro/websocket",
                  "pro/websocket-public",
                  "pro/websocket-private",
                  "pro/websocket-futures"
                ]
              },
              {
                "group": "Partners",
                "pages": [
                  "partner/overview",
                  "partner/architecture",
                  "partner/kyc",
                  "partner/kyb",
                  "partner/fiat",
                  "partner/apple-google-pay",
                  "partner/withdrawals-address-book",
                  "partner/withdrawals-wallet",
                  "partner/travel-rule",
                  "partner/transfers",
                  "partner/widgets"
                ]
              },
              {
                "group": "AI",
                "pages": [
                  "ai/overview",
                  "ai/cursor",
                  "ai/claude",
                  "ai/tools",
                  "ai/errors"
                ]
              },
              {
                "group": "Troubleshoot",
                "pages": [
                  "recipes/hmac-401",
                  "recipes/subaccount-header",
                  "recipes/rate-limit",
                  "recipes/websocket-vs-polling"
                ]
              }
            ]
          },
          {
            "tab": "REST",
            "groups": [
              {
                "group": "Using the reference",
                "pages": [
                  "wallet/rest-overview"
                ]
              },
              {
                "group": "Wallet API",
                "openapi": "openapi/crypto.json"
              }
            ]
          },
          {
            "tab": "Notifications",
            "groups": [
              {
                "group": "Gateway WebSocket",
                "pages": [
                  "wallet/websocket",
                  "wallet/websocket-events"
                ]
              }
            ]
          }
        ]
      },
      {
        "dropdown": "Pro Trading",
        "description": "Spot REST and WebSocket trading",
        "icon": "chart-line",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "pro/overview",
                  "pro/first-order",
                  "pro/market-data",
                  "guides/authentication",
                  "guides/rate-limits"
                ]
              },
              {
                "group": "Troubleshoot",
                "pages": [
                  "recipes/hmac-401",
                  "recipes/rate-limit",
                  "recipes/websocket-vs-polling"
                ]
              }
            ]
          },
          {
            "tab": "REST",
            "groups": [
              {
                "group": "Using the reference",
                "pages": [
                  "pro/rest-overview"
                ]
              },
              {
                "group": "Pro Trading REST",
                "openapi": "openapi/trading-spot-rest.json"
              }
            ]
          },
          {
            "tab": "WebSockets",
            "groups": [
              {
                "group": "Spot",
                "pages": [
                  "pro/websocket",
                  "pro/websocket-public",
                  "pro/websocket-private"
                ]
              },
              {
                "group": "Futures",
                "pages": [
                  "pro/websocket-futures"
                ]
              }
            ]
          }
        ]
      },
      {
        "dropdown": "Partner",
        "description": "B2B2C onboarding, funding, and withdrawals",
        "icon": "building",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Architecture",
                "pages": [
                  "partner/overview",
                  "partner/architecture"
                ]
              },
              {
                "group": "Onboarding",
                "pages": [
                  "partner/kyc",
                  "partner/kyb"
                ]
              },
              {
                "group": "Money movement",
                "pages": [
                  "partner/fiat",
                  "partner/apple-google-pay",
                  "partner/withdrawals-address-book",
                  "partner/withdrawals-wallet",
                  "partner/travel-rule",
                  "partner/transfers"
                ]
              },
              {
                "group": "Troubleshoot",
                "pages": [
                  "recipes/subaccount-header",
                  "recipes/withdrawals",
                  "recipes/apple-pay",
                  "recipes/social-pay",
                  "recipes/totp"
                ]
              }
            ]
          },
          {
            "tab": "REST",
            "groups": [
              {
                "group": "Using the reference",
                "pages": [
                  "partner/rest-overview"
                ]
              },
              {
                "group": "Embed",
                "openapi": "openapi/embed.json"
              }
            ]
          },
          {
            "tab": "Widgets",
            "groups": [
              {
                "group": "Embed",
                "pages": [
                  "partner/widgets",
                  "partner/embed-identity",
                  "partner/embed-add-card"
                ]
              }
            ]
          }
        ]
      },
      {
        "dropdown": "AI",
        "description": "MCP server, recipes, and agent files",
        "icon": "robot",
        "tabs": [
          {
            "tab": "MCP",
            "groups": [
              {
                "group": "Setup",
                "pages": [
                  "ai/overview",
                  "ai/cursor",
                  "ai/claude",
                  "ai/tools",
                  "ai/errors"
                ]
              }
            ]
          },
          {
            "tab": "Recipes",
            "groups": [
              {
                "group": "Common tasks",
                "pages": [
                  "recipes/hmac-401",
                  "recipes/subaccount-header",
                  "recipes/withdrawals",
                  "recipes/apple-pay",
                  "recipes/social-pay",
                  "recipes/rate-limit",
                  "recipes/totp",
                  "recipes/websocket-vs-polling"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://bit2me.mintlify.site"
    }
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wallet-api",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pro-trading",
      "destination": "/pro/overview",
      "permanent": true
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
